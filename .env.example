# Copy to server/.env for local runs. In production these are set in the
# platform (secrets and settings are never in the image or in git).

PORT=3000
HOST=127.0.0.1

# debug | info | warn | error
LOG_LEVEL=info

# comma separated; empty means any origin may connect (development only)
ALLOWED_ORIGINS=

# sockets one address may hold open
MAX_CONNECTIONS_PER_IP=20
# behind a proxy (Fly, Render, Caddy) the address is in X-Forwarded-For
TRUST_PROXY=0

MAX_ROOMS=20
MAX_PLAYERS=8

# latency injector from lab 5, never in production
ENABLE_NETSIM=0

# set by the build: git rev-parse --short HEAD
GIT_SHA=
